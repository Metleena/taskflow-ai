# ---- Server (copy to server/.env) ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
# Required: random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Email (SMTP). Without these, emails are recorded as FAILED, never as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TaskFlow <no-reply@your-company.com>"

# AI (Anthropic). Without a key, explanations/feedback show as "unavailable".
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Reminders (hours before the event, comma separated)
MEETING_REMINDER_HOURS=24,1
DEADLINE_REMINDER_HOURS=48,24

# Uploads / worker
UPLOAD_DIR=uploads
MAX_FILE_MB=15
WORKER_INTERVAL_MS=30000
MAX_EMAIL_ATTEMPTS=5

# Demo seed password (npm run seed)
SEED_PASSWORD=Demo-Password-2026
